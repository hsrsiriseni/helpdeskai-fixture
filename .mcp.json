{
  "mcpServers": {
    "fixture-mcp": {
      "command": "python",
      "args": [
        "-m",
        "src.mcp_server.server"
      ],
      "env": {
        "MCP_API_KEY_HASH": "${MCP_API_KEY_HASH}"
      }
    },
    "trent": {
      "command": "trent-mcp",
      "args": [],
      "env": {}
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
